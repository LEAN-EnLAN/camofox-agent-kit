#!/usr/bin/env node
//
// agent-studio — a headed browser you can record, that never appears on your screen.
//
// WHY A CONTAINER, AND WHY THAT MAKES IT CROSS-PLATFORM
//
// Running a virtual display on the host is Linux-only and, on a Wayland desktop,
// actively dangerous. An X display number is claimed in THREE places: the
// filesystem socket (/tmp/.X11-unix/X<n>), the lock file (/tmp/.X<n>-lock), and
// the Linux ABSTRACT-namespace socket (@/tmp/.X11-unix/X<n>). wlroots
// compositors start Xwayland with -listenfd holding only the FILESYSTEM socket,
// leaving the abstract one unclaimed — so an Xvfb hunting for a free display
// binds it, concludes :0 is free, and takes the desktop's display. Observed:
// every X11 client, GPU apps and games included, dropped from a 5120x1080
// Xwayland to a 1280x720 software Xvfb.
//
// Putting the display inside a container solves both problems at once:
//
//   * Isolation — a private mount namespace (own /tmp) plus a private NETWORK
//     namespace (own abstract-socket namespace). Nothing can collide with the
//     host's compositor, because the host's sockets are not even visible.
//
//   * Portability — the container ships its own Linux userspace and its own X
//     server, and never talks to the host's display system. Docker Desktop runs
//     a Linux VM on both macOS and Windows, so the SAME image behaves
//     identically on all three platforms. The browser runs HEADED, with real
//     window chrome, inside a screen that exists only in the container.
//
// THE ONE FLAG THAT MUST NEVER BE ADDED: --network=host. Abstract sockets are
// scoped to the NETWORK namespace, not the mount namespace, so host networking
// reintroduces the exact collision. This tool refuses it.
//
// Implemented in Node rather than bash because the kit already requires Node
// >= 22 and a shell script is not portable to a Windows host.

import { spawn, spawnSync } from "node:child_process";
import { existsSync, mkdirSync, mkdtempSync, cpSync, rmSync, accessSync, constants as fsConstants } from "node:fs";
import { tmpdir, platform as osPlatform } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const HERE = dirname(fileURLToPath(import.meta.url));
const REPO = resolve(HERE, "..");
const IMAGE = process.env.AGENT_STUDIO_IMAGE || "agent-studio:latest";
const PLATFORM = osPlatform(); // 'linux' | 'darwin' | 'win32'

const tty = process.stderr.isTTY && !process.env.NO_COLOR;
const C = tty
  ? { r: "\x1b[0m", b: "\x1b[1m", d: "\x1b[2m", red: "\x1b[31m", g: "\x1b[32m", y: "\x1b[33m" }
  : { r: "", b: "", d: "", red: "", g: "", y: "" };
const log = (m) => console.error(`${C.b}==>${C.r} ${m}`);
const ok = (m) => console.error(`${C.g}  ✔${C.r} ${m}`);
const note = (m) => console.error(`${C.y}  ~${C.r} ${m}`);
const dim = (m) => console.error(`${C.d}  ${m}${C.r}`);
function die(m) {
  console.error(`${C.red}${C.b}error${C.r} ${m}`);
  process.exit(1);
}

// --- host platform ---------------------------------------------------------
// Resolved in Node rather than by shelling out to `command -v` / `where`:
// spawning with shell:true is deprecated (DEP0190) and there is no single
// command that works on all three hosts anyway.
function which(bin) {
  const sep = PLATFORM === "win32" ? ";" : ":";
  const exts = PLATFORM === "win32"
    ? (process.env.PATHEXT || ".EXE;.CMD;.BAT").split(";")
    : [""];
  for (const dir of (process.env.PATH || "").split(sep)) {
    if (!dir) continue;
    for (const ext of exts) {
      const candidate = join(dir, bin + ext);
      try {
        accessSync(candidate, fsConstants.X_OK);
        return candidate;
      } catch {
        /* keep looking */
      }
    }
  }
  return null;
}

function runtime() {
  // podman first where it exists: rootless by default and no daemon. On macOS
  // and Windows this is almost always Docker Desktop.
  for (const c of ["podman", "docker"]) if (which(c)) return c;
  die(
    PLATFORM === "linux"
      ? "neither podman nor docker found (pacman -S docker, or podman)"
      : "Docker Desktop not found — install it from docker.com and start it",
  );
}

// Only Linux hosts have an X display that a stray X server could hijack, so
// only Linux needs the before/after safety check. On macOS (Quartz) and Windows
// (DWM) the container physically cannot reach the host's display system.
function hostDisplayFingerprint() {
  if (PLATFORM !== "linux") return null;
  if (!which("xdpyinfo")) return null;
  const r = spawnSync("xdpyinfo", [], {
    encoding: "utf8",
    env: { ...process.env, DISPLAY: process.env.DISPLAY || ":0" },
  });
  if (r.status !== 0) return null;
  const m = r.stdout.match(/dimensions:\s+(\S+)/);
  return m ? m[1] : null;
}

// --- container invocation --------------------------------------------------
function assertNotHostNet(net) {
  if (["host", "--network=host", "--net=host"].includes(net)) {
    die(
      "refusing --net host: abstract X sockets are scoped to the network namespace, " +
        "so host networking reintroduces the display hijack this tool exists to prevent",
    );
  }
}

function isolationArgs(net, { publish = [] } = {}) {
  const args = [
    `--network=${net}`,
    "--ipc=private",
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--rm",
  ];
  // --user maps the container process onto a host uid so bind-mounted artifacts
  // are owned by the caller. That is a Linux concept: Docker Desktop's VM does
  // its own ownership translation, and passing a uid there breaks writes.
  if (PLATFORM === "linux") args.push(`--user=${process.getuid()}:${process.getgid()}`);
  for (const p of publish) args.push("-p", p);
  return args;
}

function runContainer(rt, args, { inherit = true } = {}) {
  return new Promise((res) => {
    const p = spawn(rt, args, { stdio: inherit ? "inherit" : "pipe" });
    p.on("close", (code) => res(code ?? 1));
    p.on("error", (e) => die(`${rt} failed to start: ${e.message}`));
  });
}

// --- commands --------------------------------------------------------------
async function cmdBuild(argv) {
  const withCamoufox = argv.includes("--with-camoufox");
  const noCache = argv.includes("--no-cache");
  const rt = runtime();
  const dockerDir = join(REPO, "docker");
  if (!existsSync(join(dockerDir, "Dockerfile"))) die(`no Dockerfile at ${dockerDir}`);

  // Stage a minimal build context. Using the repo root would ship .git and the
  // test artifacts into the daemon for no reason.
  const ctx = mkdtempSync(join(tmpdir(), "agent-studio-ctx-"));
  try {
    cpSync(join(dockerDir, "Dockerfile"), join(ctx, "Dockerfile"));
    cpSync(join(dockerDir, "entrypoint.sh"), join(ctx, "entrypoint.sh"));
    mkdirSync(join(ctx, "tools"), { recursive: true });
    if (existsSync(join(REPO, "tools"))) cpSync(join(REPO, "tools"), join(ctx, "tools"), { recursive: true });

    log(`building ${IMAGE} on ${PLATFORM} (camoufox=${withCamoufox ? 1 : 0})`);
    const args = ["build", ...(noCache ? ["--no-cache"] : []),
      "--build-arg", `WITH_CAMOUFOX=${withCamoufox ? 1 : 0}`, "-t", IMAGE, ctx];
    const code = await runContainer(rt, args);
    if (code !== 0) die("build failed");
    ok(`built ${IMAGE}`);
  } finally {
    rmSync(ctx, { recursive: true, force: true });
  }
}

async function cmdDoctor() {
  const rt = runtime();
  log("host");
  dim(`platform    ${PLATFORM}`);
  dim(`runtime     ${which(rt)}`);
  const info = spawnSync(rt, ["info"], { encoding: "utf8" });
  if (info.status !== 0) {
    die(
      PLATFORM === "linux"
        ? `${rt} is installed but not usable by this user — is the daemon running and are you in the '${rt}' group?`
        : `${rt} is installed but not responding — is Docker Desktop running?`,
    );
  }
  ok(`${rt} usable without elevation`);

  const has = spawnSync(rt, ["image", "inspect", IMAGE], { encoding: "utf8" });
  if (has.status !== 0) {
    note(`image ${IMAGE} not built — run: agent-studio build`);
    process.exit(1);
  }
  ok(`image ${IMAGE} present`);

  const before = hostDisplayFingerprint();
  if (before) dim(`host DISPLAY=:0  ${before}`);
  else dim(`host display     n/a on ${PLATFORM} — the container cannot reach it by construction`);

  log("container");
  const code = await runContainer(rt, ["run", ...isolationArgs("none"), IMAGE, "doctor"]);

  const after = hostDisplayFingerprint();
  if (before && after && before !== after) die(`HOST DISPLAY CHANGED (${before} -> ${after}) — isolation is broken`);
  if (before) ok(`host display untouched (${after})`);
  process.exit(code);
}

async function cmdRun(argv) {
  let out = "./studio-out";
  let net = "none";
  let screen = "";
  let duration = "";
  let settle = "";
  let vnc = false;
  let vncPort = "6080";
  const rest = [];

  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    const next = () => argv[++i];
    if (a === "--out") out = next();
    else if (a === "--screen") screen = next();
    else if (a === "--duration") duration = next();
    else if (a === "--settle") settle = next();
    else if (a === "--net") { net = next(); assertNotHostNet(net); }
    else if (a === "--view") vnc = true;
    else if (a === "--view-port") vncPort = next();
    else if (a === "-h" || a === "--help") return runHelp();
    else { rest.push(...argv.slice(i)); break; }
  }
  if (!rest.length) die("no verb given (doctor|shot|record|serve|exec) — see --help");
  assertNotHostNet(net);

  const outAbs = resolve(out);
  mkdirSync(outAbs, { recursive: true });

  const rt = runtime();
  const env = [];
  if (screen) env.push("-e", `SCREEN=${screen}`);
  if (duration) env.push("-e", `DURATION=${duration}`);
  if (settle) env.push("-e", `SETTLE=${settle}`);
  const publish = [];
  if (vnc) {
    env.push("-e", "ENABLE_VNC=1");
    // Bound to loopback: a live view of a browser holding real sessions has no
    // business being reachable from the network.
    publish.push(`127.0.0.1:${vncPort}:6080`);
    if (net === "none") {
      net = "bridge";
      note("--view needs a network namespace with ports; switched --net none -> bridge");
    }
  }

  const before = hostDisplayFingerprint();
  log(`running '${rest[0]}' in ${IMAGE} (${PLATFORM}, net=${net}, out=${outAbs})`);
  if (vnc) ok(`live view: http://127.0.0.1:${vncPort}/vnc.html`);

  const code = await runContainer(rt, [
    "run", ...isolationArgs(net, { publish }),
    "-v", `${outAbs}:/out`,
    ...env, IMAGE, ...rest,
  ]);

  // Post-condition, not decoration: if a future change to the run flags ever
  // lets the container reach the host's X server, this is what catches it.
  const after = hostDisplayFingerprint();
  if (before && after && before !== after) {
    die(`HOST DISPLAY CHANGED (${before} -> ${after}) — the container escaped its namespace`);
  }
  if (before) ok(`host display unchanged (${after})`);
  log(`artifacts in ${outAbs}`);
  process.exit(code);
}

function runHelp() {
  console.error(`usage: agent-studio run [options] <verb> [args...]

  verbs   doctor
          shot   <url> [outfile]     one screenshot
          record <url> [outfile]     record the session to mp4
          serve  [url]               hold a headed session open
          exec   <cmd...>            run anything against the display

  --out DIR        host directory to receive artifacts (default ./studio-out)
  --screen WxH     display size, independent of your monitors
  --duration N     seconds to record
  --settle N       seconds to wait before a screenshot
  --net MODE       none (default) | bridge for internet. 'host' is refused.
  --view           expose a browser-based live view of the session
  --view-port N    port for it on 127.0.0.1 (default 6080)

examples
  agent-studio run --net bridge --screen 1920x1080 shot https://example.com page.png
  agent-studio run --net bridge --duration 25 record https://example.com demo.mp4
  agent-studio run --view --net bridge serve https://example.com`);
}

function usage() {
  console.error(`${C.b}agent-studio${C.r} — a headed browser you can record, that never touches your screen

  agent-studio build [--with-camoufox]   build the image
  agent-studio doctor                    check runtime, image and isolation
  agent-studio run [opts] <verb> ...     run a capture (agent-studio run --help)

Runs on Linux, macOS and Windows: the container carries its own Linux
userspace and X server, so the host's display system is never involved.`);
}

const [, , cmd, ...argv] = process.argv;
switch (cmd) {
  case "build": await cmdBuild(argv); break;
  case "doctor": await cmdDoctor(); break;
  case "run": await cmdRun(argv); break;
  case undefined: case "-h": case "--help": usage(); break;
  default: die(`unknown command: ${cmd}`);
}
