# camofox-browser service configuration.
# Installed to ~/.config/camofox-browser/camofox-browser.env
# Plain KEY=VALUE only — systemd EnvironmentFile is NOT a shell script:
# no `export`, no command substitution, no variable expansion.
#
# Apply changes with:  systemctl --user restart camofox-browser

# --- Network ---------------------------------------------------------------
# IMPORTANT: camofox-browser defaults to an EMPTY bind host, which makes
# express listen on every interface (server.js: app.listen(PORT, bindHost ||
# undefined)). An always-on service must pin this to loopback, otherwise any
# host on your network can drive your browser — cookies, logged-in sessions
# and all. Only widen this if you also set CAMOFOX_ACCESS_KEY below.
CAMOFOX_BIND_HOST=127.0.0.1
CAMOFOX_PORT=9377

# --- Lifecycle -------------------------------------------------------------
# Close the browser after this much inactivity; the server stays up at ~40MB
# and relaunches lazily on the next tab. 0 disables idle shutdown.
BROWSER_IDLE_TIMEOUT_MS=300000
# Restart the browser if its RSS crosses this, to bound leak growth.
BROWSER_RSS_RESTART_THRESHOLD_MB=2048

# --- Limits ----------------------------------------------------------------
MAX_TABS_PER_SESSION=10
MAX_TABS_GLOBAL=30
NAVIGATE_TIMEOUT_MS=30000

# --- Auth (optional) -------------------------------------------------------
# CAMOFOX_ACCESS_KEY gates EVERY route with `Authorization: Bearer <key>`.
# Required if you ever change CAMOFOX_BIND_HOST away from loopback. When set,
# the same value must reach the MCP adapter — re-run install.sh with
# --access-key so it lands in every host config.
#CAMOFOX_ACCESS_KEY=

# CAMOFOX_API_KEY gates cookie import only. Without it, /cookies returns 403.
#CAMOFOX_API_KEY=

# --- Interactive login via VNC (optional) ----------------------------------
# Lets you log into a site by hand in a real window, then hand the storage
# state to agents. Needs a VNC stack installed; leave off unless you use it.
#ENABLE_VNC=1
#VNC_BIND=127.0.0.1
#VNC_PORT=5900
#NOVNC_PORT=6080

# --- Proxy (optional) ------------------------------------------------------
# Route browser traffic through a residential proxy; GeoIP then aligns
# locale/timezone with the exit IP.
#PROXY_HOST=
#PROXY_PORT=
#PROXY_USERNAME=
#PROXY_PASSWORD=
